# UrNetwork fleet config. Copy to .env and fill in the credentials.
#   cp .env.example .env && chmod 600 .env
#
# urnet-start.sh reads this file. Credential values are never echoed.

# --- Required -------------------------------------------------------
# userpass = email/password (reusable, boots cleanly every time).
# authcode = one-time code, cached as a JWT in each node's volume.
AUTH=userpass

USER_AUTH=username
PASSWORD=password

# Only used when AUTH=authcode.
# URNETWORK_AUTH_CODE=PASTE_YOUR_AUTH_CODE_HERE

# How many provider containers to run.
URNETWORK_INSTANCE_COUNT=6

# --- Optional tuning ------------------------------------------------
# Per-connection TCP window is a hard throughput ceiling.
# auto | eco | lowmem | turbo-v4 | turbo-v8
URNETWORK_PROFILE=turbo-v8

# Open-file limit for each container (a proxy fleet needs many sockets).
URNETWORK_NOFILE=1048576

# Fleet-wide bandwidth cap. The SUM of all providers will not exceed this.
# Units are KILOBYTES per second. 1000 KB/s = 8 Mbit/s.
#   0  = no limit    -1 = no limit (explicit "infinite")
# Written as a total, so it is split evenly across URNETWORK_INSTANCE_COUNT.
# e.g. 6 with 6 containers = 1 MB/s each, 6 MB/s for the fleet.
# Enforced with tc on each container's netns; needs root + tc (see --cap).
URNETWORK_BANDWIDTH_CAP_KBPS=0

# ─── Proxy source (the bandwidth lever) ──────────────────────────────
# Live feed, preferred over a static file for rotating lists. The
# provider fetches it, dedupes against running proxies, grades each
# candidate, and reaps dead entries by itself. Proxies that fail grading
# never carry traffic, so a junk feed degrades to `direct` on its own.
PROXY_URL=
# PROXY_URL=https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/socks5/data.txt
PROXY_URL_REFRESH=1h
PROXY_URL_MAX=500

# How many nodes run residential-only (own IP, NO proxies). Those are the
# ones the network sees as a real residential exit, which scores best.
#   1 = node #1 stays on your own connection (default)
#   0 = every node may take proxies
# Pin the node that already has earnings history, so its record is kept.
URNETWORK_DIRECT_NODES=1

# Host path to a proxy list. This is the main bandwidth lever: with no
# proxies, each container is a single `direct` identity.
# Format: host:port  or  host:port:user:pass
# Skipped automatically while the file has no real entries.
PROXY_FILE=/home/solis/Documentos/Code/urn/proxies.txt

# ─── Resource ceilings (totals for the whole fleet, 0 = no limit) ────
# Split evenly across URNETWORK_INSTANCE_COUNT. Docker enforces these,
# and the provider reads its cgroup limit, so this is a hard ceiling
# regardless of what its own tuning profile thinks it has.
# Swap is disabled (swap == memory), so one node at its limit cannot
# push the host into swap thrash.
URNETWORK_MEMORY_CAP_MB=0

# Total percent of host CPUs. 100 = all cores once, so 200 = two cores.
# On a 22-core box, 1200 = ~12 cores for the fleet.
URNETWORK_CPU_CAP_PCT=0

# Pressure-adaptive pool controller. Leave unset unless you want it.
# URNETWORK_SELF_HEAL=1
